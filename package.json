{
  "name": "ims-backend",
  "version": "2.0.0",
  "description": "IoT-enabled Factory Floor Inventory Management System with RFID/BLE Tracking",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init-db": "node scripts/init-db.js",
    "seed": "node scripts/init-db.js --seed",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.js",
    "docker:build": "docker build -t ims-backend:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "keywords": [
    "inventory",
    "rfid",
    "ble",
    "iot",
    "tracking",
    "factory-floor",
    "ldap",
    "mqtt",
    "websocket"
  ],
  "author": "Your Company",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-ldapauth": "^3.0.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "mqtt": "^5.11.2",
    "socket.io": "^4.8.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.5",
    "express-rate-limit": "^7.5.0",
    "winston": "^3.17.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
