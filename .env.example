# ==============================================
# IMS Backend - IoT Factory Floor System
# ==============================================

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ims_factory_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_DIALECT=postgres

# ==============================================
# LDAP AUTHENTICATION
# ==============================================
# LDAP Server Configuration
LDAP_URL=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_CREDENTIALS=admin_password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})

# LDAP Group Mapping
LDAP_GROUP_ADMIN=cn=ims-admins,ou=groups,dc=example,dc=com
LDAP_GROUP_STORE_MANAGER=cn=ims-managers,ou=groups,dc=example,dc=com
LDAP_GROUP_OPERATOR=cn=ims-operators,ou=groups,dc=example,dc=com
LDAP_GROUP_STOREKEEPER=cn=ims-storekeepers,ou=groups,dc=example,dc=com

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_change_in_production
SESSION_MAX_AGE=86400000

# ==============================================
# RFID/BLE INTEGRATION
# ==============================================
# MQTT Broker for RFID Reader Communication
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password
MQTT_CLIENT_ID=ims-backend

# RFID Reader Topics
MQTT_TOPIC_RFID_EVENTS=rfid/events/#
MQTT_TOPIC_RFID_STATUS=rfid/status/#
MQTT_TOPIC_BLE_EVENTS=ble/events/#

# RFID Configuration
RFID_TAG_READ_TIMEOUT=5000
RFID_DUPLICATE_READ_WINDOW=2000

# BLE Configuration
BLE_BEACON_TIMEOUT=30000
BLE_RSSI_THRESHOLD=-70

# ==============================================
# WEBSOCKET CONFIGURATION
# ==============================================
# For real-time updates to frontend
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001

# ==============================================
# WORK ORDER INTEGRATION
# ==============================================
# External Work Order System API
WO_API_BASE_URL=http://external-system/api
WO_API_KEY=your_wo_api_key
WO_API_TIMEOUT=10000
WO_SYNC_INTERVAL=300000

# ==============================================
# CORS CONFIGURATION
# ==============================================
CORS_ORIGIN=http://localhost:3000

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_RFID_EVENTS=true
LOG_MOVEMENT_TRACKING=true

# ==============================================
# BUSINESS RULES
# ==============================================
# Trolly Loading Rules
ALLOW_PARTIAL_LOADING=true
REQUIRE_POSITION_VALIDATION=true

# Movement Detection
GATE_ENTRY_EXIT_TIMEOUT=10000
POSITION_UPDATE_INTERVAL=5000
